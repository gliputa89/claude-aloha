# Skopiuj do .env.local. Zmienne EXPO_PUBLIC_* trafiają do aplikacji – nie umieszczaj tu sekretów.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Strona z regulaminem i polityką prywatności (linki przy rejestracji).
EXPO_PUBLIC_SITE_URL=https://aloha-web-eight.vercel.app
# Logowanie przez Google – identyfikatory klientów OAuth z Google Cloud (publiczne).
# Web client ID: odbiorca tokenu (Android) i Client ID w Supabase. iOS client ID: logowanie na iOS (wymaga nowego builda).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
