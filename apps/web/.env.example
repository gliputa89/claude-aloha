# Skopiuj do .env.local. Na Vercel ustaw w Settings → Environment Variables.
# Lokalnie: wartości z `pnpm db:start`.
# Produkcja: https://www.alohatraining.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
# Klucz administracyjny – TYLKO po stronie serwera (zapis na listę oczekujących). Nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Publiczny odczyt profili trenerów (sekcja „Nasi trenerzy”) – klucz anon, tylko do odczytu.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adres kontaktowy w polityce prywatności i regulaminie (sprawy danych, reklamacje, usunięcie konta).
# Opcjonalne – domyślny adres jest w lib/legal/operator.ts.
# NEXT_PUBLIC_CONTACT_EMAIL=
