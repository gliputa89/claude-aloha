# Skopiuj do .env.local. Na Vercel ustaw w Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz administracyjny – TYLKO po stronie serwera. Nigdy z prefiksem NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Claude API – tylko serwer. Tester planów („Podgląd z AI”, „Plan od nowa z AI”). Produkcja: sekret w Supabase (Edge Function).
ANTHROPIC_API_KEY=

# Lokalnie najprościej pobrać zmienne stagingu z Vercel:
#   cd apps/admin && vercel link --project aloha-admin && vercel env pull .env.local --environment=development
# Dostęp do panelu: konto Supabase Auth wpisane do ops.admins (patrz README).
