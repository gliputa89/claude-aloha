{
  "name": "aloha-training",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@aloha/web",
    "dev:admin": "turbo run dev --filter=@aloha/admin",
    "dev:mobile": "pnpm --filter @aloha/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tokens": "pnpm --filter @aloha/design-system build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push:staging": "scripts/db-push.sh staging",
    "db:push:prod": "scripts/db-push.sh prod",
    "db:ci-setup": "scripts/ci-db-secrets.sh",
    "review-user": "node scripts/create-review-user.mjs",
    "eas-env:prod": "scripts/eas-env-prod.sh",
    "db:types": "supabase gen types typescript --local > packages/db/src/database.types.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "supabase": "^3.0.0"
  }
}
